# .env.example — copy to .dev.vars for local wrangler dev
#
# All keys in this file correspond to Wrangler Worker secrets unless noted.
# [vars] entries (ENVIRONMENT, CLOUDFLARE_ACCOUNT_ID, etc.) live in wrangler.toml
# and do NOT belong in .dev.vars — they are declared statically.
#
# NEXT_PUBLIC_API_URL belongs in frontend/.env.local, not .dev.vars.
#
# To generate: bash scripts/generate-env-example.sh
# To check for drift: bash scripts/generate-env-example.sh --check

# ── Auth ──────────────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=

# Exactly 32 raw bytes, base64-encoded (AES-GCM key for OAuth token storage).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────────
# Required. Claude (MARTy, classification, enrichment). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Gemini 2.5 Flash enrichment. https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# ── Microsoft Graph (Outlook mail + calendar) ─────────────────────────────────
# Required for Outlook integration. https://entra.microsoft.com
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# "common" for multi-tenant or your tenant UUID for single-tenant
AZURE_TENANT_ID=
# Must exactly match the redirect URI registered in Entra. e.g. https://<worker>/auth/outlook/callback
AZURE_REDIRECT_URI=

# ── Slack ─────────────────────────────────────────────────────────────────────
# Required for Slack integration. https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Basic Information → Signing Secret (NOT the OAuth client secret)
SLACK_SIGNING_SECRET=
# xoxb-... bot token from OAuth & Permissions
SLACK_BOT_TOKEN=

# ── Firefly ───────────────────────────────────────────────────────────────────
# HMAC-SHA256 secret you configure in Firefly's webhook settings.
# Must match exactly what you enter at https://fireflies.ai → Settings → Developer → Webhooks
FIREFLY_WEBHOOK_SECRET=

# ── Enrichment ────────────────────────────────────────────────────────────────
# Required for ReverseContact enrichment. https://www.reversecontact.com
REVERSECONTACT_API_KEY=

# ── Cloudflare (pipelines Worker) ─────────────────────────────────────────────
# Required by the pipelines Worker (medina-ventures-pipelines).
# AI Gateway token: Cloudflare dashboard → AI → AI Gateway → your gateway → API tokens
CLOUDFLARE_AI_GATEWAY_TOKEN=
# Cloudflare API token with Workers:Edit permission (used by the workflow state reconciler).
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# ── Signup / tenant config (optional) ─────────────────────────────────────────
# org UUID assigned to self-signup users. Run scripts/seed-default-org.sh to generate.
DEFAULT_SIGNUP_ORG_ID=
# Comma-separated email domains allowed to self-sign-up (e.g. "acme.com,acme.io")
ALLOWED_SIGNUP_DOMAINS=

# ── Frontend (frontend/.env.local — NOT .dev.vars) ────────────────────────────
# This key belongs in frontend/.env.local, NOT in .dev.vars.
# Create frontend/.env.local separately: echo "NEXT_PUBLIC_API_URL=http://127.0.0.1:8787" > frontend/.env.local
NEXT_PUBLIC_API_URL=
