{
  "name": "medina-ventures-api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"wrangler dev --remote\" \"npm --prefix frontend run dev\"",
    "dev:api": "wrangler dev --remote",
    "dev:web": "npm --prefix frontend run dev",
    "deploy": "wrangler deploy",
    "deploy:pipelines": "wrangler deploy --config wrangler.pipelines.toml",
    "deploy:all-workers": "npm run deploy && npm run deploy:pipelines",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy:pipelines:dry": "wrangler deploy --config wrangler.pipelines.toml --dry-run",
    "migrate:local": "wrangler d1 migrations apply medina-ventures-db --local",
    "migrate:remote": "wrangler d1 migrations apply medina-ventures-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agent": "vitest run tests/agent-runtime.test.ts tests/agent-tools.test.ts tests/citations.test.ts tests/claude.test.ts tests/firm-relationship-state.test.ts",
    "test:max": "vitest run tests/max-set-builder.test.ts",
    "prospect:spike": "tsx scripts/prospect-classifier-spike.ts",
    "prospect:universes": "tsx scripts/prospect-classifier-universe-spike.ts",
    "prospect:classifier-gate": "tsx scripts/prospect-classifier-gate.ts",
    "prospect:pipeline-readiness": "tsx scripts/prospect-pipeline-readiness.ts",
    "prospect:pipeline-canary": "tsx scripts/prospect-pipeline-canary.ts",
    "prospect:hydrated-eval": "tsx scripts/prospect-hydrated-eval.ts",
    "prospect:hydrated-eval-merge": "tsx scripts/prospect-hydrated-eval-merge.ts",
    "prospect:hydrated-eval-24-shard": "tsx scripts/prospect-hydrated-eval-24-shard.ts",
    "prospect:freeze-backfill-window": "tsx scripts/prospect-freeze-backfill-window.ts",
    "prospect:live-canary": "tsx scripts/prospect-live-canary.ts",
    "prospect:live-provisional-cleanup": "tsx scripts/prospect-live-provisional-cleanup.ts",
    "prospect:backfill-window": "tsx scripts/prospect-backfill-window.ts",
    "prospect:backfill-enqueue": "tsx scripts/prospect-backfill-enqueue.ts",
    "prospect:production-reset": "tsx scripts/prospect-production-reset.ts",
    "prospect:artifact-import": "tsx scripts/prospect-artifact-import.ts",
    "prospect:cutover-cleanup": "tsx scripts/prospect-cutover-cleanup.ts",
    "prospect:seed-aliases": "tsx scripts/prospect-seed-identity-aliases.ts",
    "prospect:pipeline-health": "tsx scripts/prospect-pipeline-health.ts",
    "prospect:migration-readiness": "tsx scripts/prospect-migration-readiness-check.ts",
    "prospect:large-experiment": "tsx scripts/prospect-large-classifier-experiment.ts",
    "prospect:materialize-known-deals": "tsx scripts/prospect-materialize-known-deals.ts",
    "prospect:bridge-materialize": "tsx scripts/prospect-bridge-materialize.ts",
    "crm:quality-review": "tsx scripts/crm-quality-review-export.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@langchain/textsplitters": "^1.0.1",
    "@types/papaparse": "^5.5.2",
    "@xmldom/xmldom": "^0.8.13",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/node": "^20.14.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.85.0"
  }
}
